#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(data.table)
  library(ggplot2)
})

# ============================================================
# USER SETTINGS
# ============================================================

INDIR  <- "/private/groups/kaylab/popoolation2/populations/fullpops/popacross/fst"
FAI    <- "/private/groups/kaylab/popoolation2/populations/scaffolded_assemblies/LPJR3B2_primary_scaffolds_final.fa.fai"
OUTDIR <- file.path(INDIR, "windowed_plot_output")

PREFIX <- "Across-patch Fst"

WINDOW_SIZE <- 10000

MIN_SCAFFOLD_LEN <- 0
MIN_WINDOW_SNPS_RAW <- 1
MIN_WINDOW_SNPS_FINAL <- 1

MAX_POINTS_TO_PLOT <- 500000

POINT_SIZE <- 0.65

dir.create(OUTDIR, recursive = TRUE, showWarnings = FALSE)

WINDOW_FILE <- file.path(
  OUTDIR,
  paste0(PREFIX, "_windowed_", WINDOW_SIZE, "bp.tsv.gz")
)

PLOT_FILE <- file.path(
  OUTDIR,
  paste0(PREFIX, "_windowed_", WINDOW_SIZE, "bp.png")
)

SUMMARY_FILE <- file.path(
  OUTDIR,
  paste0(PREFIX, "_windowed_", WINDOW_SIZE, "bp_summary.tsv")
)
# ============================================================
# READ FAI
# ============================================================

read_fai <- function(fai_file, min_scaffold_len = 0) {
  fai <- fread(fai_file, header = FALSE)
  fai <- fai[, .(CHR = V1, LEN = as.numeric(V2))]

  fai[, scaffold_num := suppressWarnings(as.numeric(sub("^scaffold_", "", CHR)))]

  if (all(!is.na(fai$scaffold_num))) {
    setorder(fai, scaffold_num)
  } else {
    setorder(fai, -LEN)
  }

  fai <- fai[LEN >= min_scaffold_len]

  fai[, SCAFFOLD_INDEX := seq_len(.N)]
  fai[, OFFSET := cumsum(as.numeric(shift(LEN, fill = 0)))]
  fai[, END := OFFSET + LEN]
  fai[, MID := OFFSET + LEN / 2]
  fai[, COLOR_GROUP := rep(c("A", "B"), length.out = .N)]

  fai[, .(CHR, LEN, SCAFFOLD_INDEX, OFFSET, END, MID, COLOR_GROUP)]
}

# ============================================================
# READ ONE POOPOOLATION2 FST FILE
# ============================================================
read_fst_file <- function(file) {
  dt <- tryCatch(
    fread(file, header = FALSE, sep = "\t", fill = TRUE, showProgress = FALSE),
    error = function(e) NULL
  )

  if (is.null(dt) || nrow(dt) == 0) return(NULL)
  if (ncol(dt) < 6) return(NULL)

  dt <- dt[, .(
    CHR = V1,
    BP = suppressWarnings(as.numeric(V2)),
    RAW_N_SNPS = suppressWarnings(as.numeric(V3)),
    VALUE = V6
  )]

  dt[, FST := suppressWarnings(as.numeric(sub(".*=", "", VALUE)))]

  dt <- dt[
    !is.na(CHR) &
      !is.na(BP) &
      !is.na(FST) &
      !is.na(RAW_N_SNPS) &
      RAW_N_SNPS >= MIN_WINDOW_SNPS_RAW &
      FST >= 0
  ]

  if (nrow(dt) == 0) return(NULL)

  dt[, .(CHR, BP, RAW_N_SNPS, FST)]
}

# ============================================================
# REDUCE TO FIXED WINDOWS

reduce_to_windows <- function(dt, window_size = 10000, min_window_snps_final = 1) {
  if (is.null(dt) || nrow(dt) == 0) return(NULL)

  dt[, WINDOW_START := ((BP - 1) %/% window_size) * window_size + 1]
  dt[, WINDOW_END := WINDOW_START + window_size - 1]

  out <- dt[, .(
    N_RECORDS = .N,
    N_SNPS = sum(RAW_N_SNPS, na.rm = TRUE),
    MEAN_FST = weighted.mean(FST, w = pmax(RAW_N_SNPS, 1), na.rm = TRUE)
  ), by = .(CHR, WINDOW_START, WINDOW_END)]

  out <- out[N_SNPS >= min_window_snps_final]

  if (nrow(out) == 0) return(NULL)

  out[]
}

# ============================================================
# MAIN
# ============================================================

cat("Reading FAI...\n")
fai <- read_fai(FAI, min_scaffold_len = MIN_SCAFFOLD_LEN)
cat("Scaffolds retained:", nrow(fai), "\n\n")

cat("Finding FST files...\n")

files <- sort(list.files(
  INDIR,
  pattern = "\\.fst$",
  full.names = TRUE,
  recursive = FALSE
))

cat("Number of .fst files found by R:", length(files), "\n")

shell_count <- system2(
  "find",
  args = c(INDIR, "-maxdepth", "1", "-name", "*.fst", "-size", "+0c"),
  stdout = TRUE
)

cat("Number of non-empty .fst files found by shell find:", length(shell_count), "\n\n")

if (length(files) == 0) {
  stop("No .fst files found in INDIR: ", INDIR)
}

window_list <- vector("list", length(files))
cat("Reducing FST files to", WINDOW_SIZE, "bp windows...\n\n")

for (i in seq_along(files)) {
  f <- files[i]

  if (i %% 50 == 0 || i == 1 || i == length(files)) {
    cat("[", i, "/", length(files), "] ", basename(f), "\n", sep = "")
  }

  dt <- read_fst_file(f)

  if (is.null(dt)) next

  dt <- dt[CHR %in% fai$CHR]

  if (nrow(dt) == 0) {
    rm(dt)
    next
  }

  reduced <- reduce_to_windows(
    dt,
    window_size = WINDOW_SIZE,
    min_window_snps_final = MIN_WINDOW_SNPS_FINAL
  )

  rm(dt)

  if (!is.null(reduced) && nrow(reduced) > 0) {
    window_list[[i]] <- reduced
  }

  if (i %% 100 == 0) gc()
}

cat("\nCombining reduced windows...\n")
window_list <- Filter(Negate(is.null), window_list)

if (length(window_list) == 0) {
  stop("No usable windows were produced.")
}

win_dt <- rbindlist(window_list, use.names = TRUE, fill = TRUE)
rm(window_list)
gc()

win_dt <- win_dt[, .(
  N_RECORDS = sum(N_RECORDS, na.rm = TRUE),
  N_SNPS = sum(N_SNPS, na.rm = TRUE),
  MEAN_FST = weighted.mean(MEAN_FST, w = pmax(N_SNPS, 1), na.rm = TRUE)
), by = .(CHR, WINDOW_START, WINDOW_END)]

cat("Final number of unique windows:", nrow(win_dt), "\n\n")

cat("Adding genome offsets...\n")
win_dt <- merge(win_dt, fai, by = "CHR", all.x = TRUE)
win_dt <- win_dt[!is.na(OFFSET)]

win_dt[, BPcum := OFFSET + ((WINDOW_START + WINDOW_END) / 2)]
setorder(win_dt, OFFSET, WINDOW_START)

# ============================================================
# GENOME-WIDE FST SUMMARY
# ============================================================

genome_mean_fst_unweighted <- mean(win_dt$MEAN_FST, na.rm = TRUE)

genome_median_fst_unweighted <- median(win_dt$MEAN_FST, na.rm = TRUE)

genome_mean_fst_weighted_by_snps <- weighted.mean(
  win_dt$MEAN_FST,
  w = pmax(win_dt$N_SNPS, 1),
  na.rm = TRUE
)

summary_dt <- data.table(
  PREFIX = PREFIX,
  WINDOW_SIZE = WINDOW_SIZE,
  N_FST_FILES_FOUND = length(files),
  N_WINDOWS = nrow(win_dt),
  TOTAL_SNPS_USED_ACROSS_WINDOWS = sum(win_dt$N_SNPS, na.rm = TRUE),
  GENOME_MEAN_FST_UNWEIGHTED = genome_mean_fst_unweighted,
  GENOME_MEDIAN_FST_UNWEIGHTED = genome_median_fst_unweighted,
  GENOME_MEAN_FST_WEIGHTED_BY_SNPS = genome_mean_fst_weighted_by_snps
)

cat("Genome-wide mean FST, unweighted by window: ", genome_mean_fst_unweighted, "\n", sep = "")
cat("Genome-wide median FST, unweighted by window: ", genome_median_fst_unweighted, "\n", sep = "")
cat("Genome-wide mean FST, weighted by SNP count: ", genome_mean_fst_weighted_by_snps, "\n\n", sep = "")

SUMMARY_FILE <- file.path(
  OUTDIR,
  paste0(PREFIX, "_windowed_", WINDOW_SIZE, "bp_summary.tsv")
)

fwrite(summary_dt, SUMMARY_FILE, sep = "\t")

# ============================================================
# TOP 0.1% MOST DIFFERENTIATED WINDOWS
# ============================================================

TOP_PROP <- 0.001

n_top <- ceiling(nrow(win_dt) * TOP_PROP)

top_windows <- copy(win_dt)[order(-MEAN_FST)]
top_windows <- top_windows[1:n_top]

top_windows[, RANK := seq_len(.N)]
setcolorder(top_windows, c(
  "RANK",
  "CHR",
  "WINDOW_START",
  "WINDOW_END",
  "MEAN_FST",
  "N_SNPS",
  "N_RECORDS"
))

TOP_WINDOWS_FILE <- file.path(
  OUTDIR,
  paste0(PREFIX, "_top_0.1_percent_windows_", WINDOW_SIZE, "bp.tsv")
)

fwrite(top_windows, TOP_WINDOWS_FILE, sep = "\t")

cat("Top 0.1% windows written to: ", TOP_WINDOWS_FILE, "\n", sep = "")
cat("Number of top windows: ", n_top, "\n\n", sep = "")

cat("Top 0.1% windows: ", TOP_WINDOWS_FILE, "\n", sep = "")

# ============================================================
# OPTIONAL THINNING FOR PLOTTING ONLY
# ============================================================

plot_dt <- copy(win_dt)

if (!is.null(MAX_POINTS_TO_PLOT) && nrow(plot_dt) > MAX_POINTS_TO_PLOT) {
  set.seed(1)
  plot_dt <- plot_dt[sample(.N, MAX_POINTS_TO_PLOT)]
  setorder(plot_dt, OFFSET, WINDOW_START)
  cat("Plotting thinned data:", nrow(plot_dt), "points\n")
} else {
  cat("Plotting all windows:", nrow(plot_dt), "points\n")
}
# ============================================================
# X-AXIS LABELS
# Label every 10th scaffold through scaffold 100,
# then every 500th scaffold afterward.
# ============================================================

axis_dt <- fai[, .(CHR, MID, SCAFFOLD_INDEX, COLOR_GROUP)]

axis_dt[, LABEL := fifelse(
  SCAFFOLD_INDEX <= 100 & SCAFFOLD_INDEX %% 10 == 1,
  CHR,
  fifelse(
    SCAFFOLD_INDEX > 100 & SCAFFOLD_INDEX %% 1000 == 1,
    CHR,
    ""
  )
)]

# ============================================================
# PLOT
# ============================================================

cat("Making PNG plot...\n")

p <- ggplot(plot_dt, aes(x = BPcum, y = MEAN_FST, color = COLOR_GROUP)) +
  geom_point(size = POINT_SIZE, alpha = 0.75, stroke = 0) +
  scale_color_manual(values = c("A" = "grey20", "B" = "grey60")) +
  scale_x_continuous(
    labels = axis_dt$LABEL,
    breaks = axis_dt$MID,
    expand = c(0.005, 0.005)
  ) +
  labs(
    title = paste0(PREFIX, " Genome-wide FST (", WINDOW_SIZE, " bp windows)"),
    subtitle = paste0(
      "Genome-wide mean FST = ",
      signif(genome_mean_fst_weighted_by_snps, 4),
      " weighted by SNP count; ",
      nrow(win_dt),
      " windows plotted"
    ),
    x = "Scaffold",
    y = paste0("Mean ", WINDOW_SIZE, " bp window FST")
  ) +
  theme_bw(base_size = 12) +
  theme(
    legend.position = "none",
    panel.grid.major.x = element_blank(),
    panel.grid.minor.x = element_blank(),
    axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1, size = 6)
  )

ggsave(PLOT_FILE, p, width = 16, height = 7, units = "in", dpi = 300, bg = "white")

cat("\nDone.\n")
cat("Window table:  ", WINDOW_FILE, "\n", sep = "")
cat("Summary table: ", SUMMARY_FILE, "\n", sep = "")
cat("PNG plot:      ", PLOT_FILE, "\n", sep = "")
